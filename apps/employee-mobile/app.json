{
  "expo": {
    "name": "Employee Portal",
    "slug": "employee-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "employeeportal",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cache.employeeportal",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock the employee app with Face ID.",
        "NSCameraUsageDescription": "Capture a selfie for face verification and scan asset barcodes.",
        "NSLocationWhenInUseUsageDescription": "Location is used when punching attendance.",
        "NSPhotoLibraryUsageDescription": "Optional photo access for face verification."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f8f9ff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.cache.employeeportal",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f8f9ff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Employee Portal to use your location for attendance punch."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Employee Portal to use the camera for face verification.",
          "photosPermission": "Allow Employee Portal to access photos for face verification."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Employee Portal to scan asset barcodes and QR codes."
        }
      ],
      "expo-notifications",
      "expo-local-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

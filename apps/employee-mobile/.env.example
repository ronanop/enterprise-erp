# Copy to .env for local overrides (Expo loads EXPO_PUBLIC_* at bundle time).

# Default false (matches web ESS). Set true for offline demo without ERP.
EXPO_PUBLIC_USE_MOCK=false

# Absolute ERP API base (no trailing slash). Used when USE_MOCK=false.
# Do NOT use 127.0.0.1 on a physical phone — that points at the phone, not your PC.
# Android emulator → host machine: http://10.0.2.2:8000/api/v1
# Physical device  → your PC LAN IP: http://172.16.x.x:8000/api/v1
EXPO_PUBLIC_API_URL=http://172.16.110.94:8000/api/v1

EXPO_PUBLIC_APP_NAME=Employee Portal

# Optional rich payslip mocks for UI review
EXPO_PUBLIC_PAYSLIP_MOCK=false

# Copy to .env for local overrides (Expo loads EXPO_PUBLIC_* at bundle time).

# Default true for Phase 0 — no ERP required.
EXPO_PUBLIC_USE_MOCK=true

# Absolute ERP API base (no trailing slash). Used when USE_MOCK=false.
# Android emulator → host machine: http://10.0.2.2:8000/api/v1
# Physical device → your LAN IP:   http://192.168.x.x:8000/api/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

EXPO_PUBLIC_APP_NAME=Employee Portal

# Prefer /api/v1 — proxied to ERP in dev (see next.config.ts API_PROXY_TARGET)
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=Employee App
# true = in-app demo data (no ERP required). Set false for live API.
NEXT_PUBLIC_USE_MOCK=false
# Server-side proxy target (not exposed to browser)
# API_PROXY_TARGET=http://127.0.0.1:8000
# LAN / Tailscale HMR (comma-separated host:port or full URL)
# ALLOWED_DEV_ORIGINS=192.168.1.42:3001,http://100.64.0.5:3001

{
  "expo": {
    "name": "iConnect+",
    "slug": "employee-app-by-rishabh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "employeeportal",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.iconnectplusin.employeeportal",
      "infoPlist": {
        "NSFaceIDUsageDescription": "iConnect Plus uses Face ID so you can unlock the employee app. You can also use Touch ID or your device passcode (screen lock).",
        "NSCameraUsageDescription": "The app uses the camera to capture an attendance selfie, verify your face at login, and scan asset barcodes.",
        "NSLocationWhenInUseUsageDescription": "The app uses precise GPS while you punch attendance so your check-in can be verified at your workplace.",
        "NSPhotoLibraryUsageDescription": "The app lets you choose and crop photos or short videos for the workplace feed, and upload documents or profile images.",
        "NSPhotoLibraryAddUsageDescription": "The app can save files you download (such as payslips) to your photo library when you choose Save.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.iconnectplusin.employeeportal",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f8f9ff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The app uses precise GPS while you punch attendance so your check-in can be verified at your workplace."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "The app uses the camera to capture an attendance selfie, verify your face at login, and scan asset barcodes.",
          "photosPermission": "The app lets you choose and crop photos or short videos for the workplace feed, and upload documents or profile images."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The app uses the camera to scan asset barcodes and QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#004ac6",
          "defaultChannel": "ess-alerts",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "iConnect Plus uses Face ID so you can unlock the employee app. You can also use Touch ID or your device passcode (screen lock)."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "29a70c4a-fdf9-4483-b0cf-7ac1716d022d"
      }
    },
    "owner": "rishabhgaurcache"
  }
}

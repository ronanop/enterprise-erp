# Copy to .env for local overrides (Expo loads EXPO_PUBLIC_* at bundle time).

# Absolute ERP API base (no trailing slash). The ERP API talks to the remote HRMS
# using the settings saved in Organization -> Users -> HRMS API; the phone never
# holds the HRMS key.
# Android emulator -> host machine: http://10.0.2.2:8000/api/v1
# Physical device / Expo Go       -> your LAN IP: http://192.168.x.x:8000/api/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Browser preview on this PC (avoids LAN/WARP fetch failures).
EXPO_PUBLIC_API_URL_WEB=http://127.0.0.1:8000/api/v1

EXPO_PUBLIC_APP_NAME=Employee App by Rishabh

# true = in-memory demo API, no ERP required (show Demo mode banner).
# Store / Play / App Store builds must keep this false and point at staging/prod API.
# See docs/STORE_REVIEW_STAGING.md
EXPO_PUBLIC_USE_MOCK=false

# Required for App Store / Play — host these on iconnectplus.in before submit.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://iconnectplus.in/legal/privacy
EXPO_PUBLIC_TERMS_URL=https://iconnectplus.in/legal/terms
EXPO_PUBLIC_DATA_DELETION_URL=https://iconnectplus.in/legal/data-deletion
EXPO_PUBLIC_SUPPORT_EMAIL=erp@iconnectplus.in

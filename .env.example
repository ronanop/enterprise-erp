# =============================================================================
# Enterprise ERP Platform â€” Environment Configuration
# Copy to .env and adjust values for local development.
# =============================================================================

# Application
APP_NAME=Enterprise ERP API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://erp:erp_dev_password@localhost:5433/erp

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=amqp://erp:erp_dev_password@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# RabbitMQ
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=erp_dev_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# MinIO (S3-compatible)
MINIO_ROOT_USER=erp_minio
MINIO_ROOT_PASSWORD=erp_minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=erp-documents

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://localhost:9200

# Auth / session (long-lived for local demo; tighten in production)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_TTL_SECONDS=604800
LOGIN_RATE_LIMIT=0
LOGIN_RATE_WINDOW_SECONDS=900
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Enterprise ERP
NEXT_PUBLIC_DEMO_EMAIL=admin@example.com
NEXT_PUBLIC_DEMO_PASSWORD=Secure1!

# ElevenLabs Convai chat widget (public agent id — shown after login in app shell)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_6801kz33m906e7famdw9cy2n0sgw

# Microsoft Graph email (Foundation Notification Engine)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_FROM_EMAIL=
# sync = deliver in API request (local); async = Celery worker
EMAIL_DELIVERY_MODE=sync

# ElevenLabs Conversational AI (voice agent — API key server-side only)
# Either name works; XI_API_KEY is ElevenLabs' conventional name.
XI_API_KEY=
# ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# MCP server (curated ERP tools for ElevenLabs)
MCP_SERVER_BASE_URL=http://127.0.0.1:8000
MCP_AUTH_TOKEN=

# ngrok — public MCP URL for ElevenLabs (dev). One-time: ngrok config add-authtoken <token>
# Run tunnel: .\mcp-server\scripts\tunnel-mcp.ps1  (use printed https://….ngrok-free.app/mcp/ in dashboard)
# NGROK_AUTHTOKEN=

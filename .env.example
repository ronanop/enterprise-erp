# =============================================================================
# Enterprise ERP Platform — Environment Configuration
# Copy to .env and adjust values for local development.
# =============================================================================

# Application
APP_NAME=Enterprise ERP API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
# Business-day timezone for attendance punch "today" (IST by default)
APP_TIMEZONE=Asia/Kolkata

# Optional LAN/private IP pattern for CORS (uncomment when needed)
# CORS_ORIGIN_REGEX=https?://(172\.16\.\d{1,3}\.\d{1,3}|localhost|127\.0\.0\.1)(:\d+)?
# CRM attachment directory (Docker: /app/var/crm-attachments)
# CRM_UPLOAD_ROOT=
# Customer tracker upload directory (default: apps/api/var/project-trackers)
# PROJECT_TRACKER_UPLOAD_ROOT=

# API
API_HOST=0.0.0.0
API_PORT=8000
# Includes ERP web (:3000) and Employee App PWA (:3001)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# Infrastructure on LAN VM 172.16.200.26 (primary). Local Docker used when VM is down.
INFRA_FALLBACK_ENABLED=true
# Postgres
POSTGRES_USER=erp-postgres
POSTGRES_PASSWORD=erp-postgres
POSTGRES_DB=erp
POSTGRES_HOST=172.16.200.26
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://erp-postgres:erp-postgres@172.16.200.26:5432/erp
DATABASE_URL_FALLBACK=postgresql+psycopg://erp:erp_dev_password@localhost:5433/erp

# Redis
REDIS_HOST=172.16.200.26
REDIS_PORT=6379
REDIS_URL=redis://172.16.200.26:6379/0
REDIS_URL_FALLBACK=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=amqp://erp:erp_dev_password@172.16.200.26:5672//
CELERY_BROKER_URL_FALLBACK=amqp://erp:erp_dev_password@localhost:5672//
CELERY_RESULT_BACKEND=redis://172.16.200.26:6379/1
CELERY_RESULT_BACKEND_FALLBACK=redis://localhost:6379/1

# RabbitMQ (UI: http://172.16.200.26:15672)
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=erp_dev_password
RABBITMQ_HOST=172.16.200.26
RABBITMQ_PORT=5672

# MinIO (API :9000 · Console http://172.16.200.26:9001)
MINIO_ROOT_USER=erp_minio
MINIO_ROOT_PASSWORD=erp_minio_password
MINIO_ENDPOINT=172.16.200.26:9000
MINIO_ENDPOINT_FALLBACK=localhost:9000
MINIO_BUCKET=erp-documents

# OpenSearch
OPENSEARCH_HOST=172.16.200.26
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://172.16.200.26:9200
OPENSEARCH_URL_FALLBACK=http://localhost:9200

# Auth / session (long-lived for local demo; tighten in production)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_TTL_SECONDS=604800
LOGIN_RATE_LIMIT=0
LOGIN_RATE_WINDOW_SECONDS=900
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15

# Microsoft Entra ID (Organization users SSO)
# Register redirect URI: http://localhost:8000/api/v1/auth/microsoft/callback
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
FRONTEND_URL=http://localhost:3000
# Sync users from Entra (scripts.sync_entra_organization_users)
MICROSOFT_USER_EMAIL_DOMAIN=cachedigitech.com
MICROSOFT_PLATFORM_ADMIN_EMAILS=techbank@cachedigitech.com

# Push notifications (legacy FCM). Leave empty to keep stub deliveries.
FCM_SERVER_KEY=

# Frontend — primary API + optional fallback when primary host is unreachable
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL_FALLBACK=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_APP_NAME=Enterprise ERP
NEXT_PUBLIC_DEMO_EMAIL=admin@example.com
NEXT_PUBLIC_DEMO_PASSWORD=Secure1!

# Microsoft Graph email (Foundation Notification Engine)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_FROM_EMAIL=
# sync = deliver in API request (local); async = Celery worker
EMAIL_DELIVERY_MODE=sync
# Project stage-save admin emails (requires Graph Mail.Send). Keep false until consent.
PROJECT_STAGE_EMAIL_NOTIFICATIONS_ENABLED=false

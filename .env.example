# =============================================================================
# iConnect Plus - Environment Configuration
# Copy to .env and adjust values for local development.
# =============================================================================

# Application
APP_NAME=iConnect Plus API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
# Business-day timezone for attendance punch "today" (IST by default)
APP_TIMEZONE=Asia/Kolkata

# Optional LAN/private IP pattern for CORS (uncomment when needed)
# CORS_ORIGIN_REGEX=https?://(172\.16\.\d{1,3}\.\d{1,3}|localhost|127\.0\.0\.1)(:\d+)?
# CRM attachment directory (Docker: /app/var/crm-attachments)
# CRM_UPLOAD_ROOT=
# Customer tracker upload directory (default: apps/api/var/project-trackers)
# PROJECT_TRACKER_UPLOAD_ROOT=

# API
API_HOST=0.0.0.0
API_PORT=8000
# Includes ERP web (:3000) and Employee App PWA (:3001)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# Infrastructure on LAN VM (primary). Local Docker used when VM is down.
INFRA_FALLBACK_ENABLED=true
# Postgres / AWS RDS
POSTGRES_USER=erp-postgres
POSTGRES_PASSWORD=erp-postgres
POSTGRES_DB=erp
POSTGRES_HOST=172.16.200.30
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://erp-postgres:erp-postgres@172.16.200.30:5433/erp
DATABASE_URL_FALLBACK=postgresql+psycopg://erp-postgres:erp-postgres@localhost:5433/erp

# Redis
REDIS_HOST=172.16.200.30
REDIS_PORT=6379
REDIS_URL=redis://172.16.200.30:6379/0
REDIS_URL_FALLBACK=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=amqp://erp:erp_dev_password@172.16.200.30:5672//
CELERY_BROKER_URL_FALLBACK=amqp://erp:erp_dev_password@localhost:5672//
CELERY_RESULT_BACKEND=redis://172.16.200.30:6379/1
CELERY_RESULT_BACKEND_FALLBACK=redis://localhost:6379/1

# RabbitMQ (UI: http://172.16.200.30:15672)
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=erp_dev_password
RABBITMQ_HOST=172.16.200.30
RABBITMQ_PORT=5672

# Object storage — MinIO on VM (local MinIO when VM is down)
OBJECT_STORAGE_BACKEND=minio
ASSET_STORAGE_BACKEND=minio
S3_BUCKET=cache-erp-bucket
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://172.16.200.30:9000
S3_ENDPOINT_URL_FALLBACK=http://localhost:9000
AWS_ACCESS_KEY_ID=erp_minio
AWS_SECRET_ACCESS_KEY=erp_minio_password

# OpenSearch
OPENSEARCH_HOST=172.16.200.30
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://172.16.200.30:9200
OPENSEARCH_URL_FALLBACK=http://localhost:9200

# Auth / session (long-lived for local demo; tighten in production)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_TTL_SECONDS=604800
LOGIN_RATE_LIMIT=0
LOGIN_RATE_WINDOW_SECONDS=900
# Global API rate limit per client IP (0 disables). Use ~300–600 for AppScan / production.
# Keep 0 locally if the home dashboard fans out many GETs.
API_RATE_LIMIT=0
API_RATE_WINDOW_SECONDS=60
# Mutating methods (POST/PUT/PATCH/DELETE) — data-entry flood protection.
API_WRITE_RATE_LIMIT=120
API_WRITE_RATE_WINDOW_SECONDS=60
# Multipart + upload-path JSON (attachments, documents, imports).
API_UPLOAD_RATE_LIMIT=30
API_UPLOAD_RATE_WINDOW_SECONDS=60
# Max length for normal JSON string fields (content_base64 exempt).
API_MAX_ENTRY_STRING_LENGTH=20000
# Max Content-Length for upload requests (bytes).
API_MAX_UPLOAD_REQUEST_BYTES=47185920
# Demo credentials (admin@example.com / Secure1!). Set false on shared / VAPT hosts.
ALLOW_DEMO_LOGIN=true
SESSION_BIND_USER_AGENT=true
SESSION_BIND_IP=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15

# Landing access gate (iconnectplus.com Sign in → demo ERP | iConnectPlus ERP)
# Codes are case-insensitive; spaces are ignored. Override in Coolify for production.
ACCESS_CODE_DEMO=ICP-DEMO-2026
ACCESS_CODE_CONNECTPLUS=ICP-CONNECT-2026
ACCESS_GATE_TOKEN_HOURS=12

# Sign-in: user id (work email or HRMS employee code) + password.
# Password reset links point at FRONTEND_URL/reset-password.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_MINUTES=30
ORG_EMAIL_DOMAIN=cachedigitech.com
# ERP admins are stored in the DB (sec_user.user_type). Create/repair with:
#   python -m scripts.bootstrap_erp_admin --email ... --password ...
# ERP logins are synced from HRMS onboarded employees whose code matches this pattern.
HRMS_EMPLOYEE_CODE_PATTERN=^[A-Za-z]{2,6}[0-9]{3,}$

# Push notifications (legacy FCM). Leave empty to keep stub deliveries.
FCM_SERVER_KEY=

# Next.js rewrite target for /api/v1 (local next dev). Docker Compose overrides to http://api:8000.
API_INTERNAL_URL=http://127.0.0.1:8000

# Frontend API base (same-origin /api/v1 is preferred behind nginx)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL_FALLBACK=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_APP_NAME=iConnect Plus
NEXT_PUBLIC_DEMO_EMAIL=admin@example.com
NEXT_PUBLIC_DEMO_PASSWORD=Secure1!

# ElevenLabs Convai chat widget (public agent id - shown after login in app shell)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_6801kz33m906e7famdw9cy2n0sgw

# Foundation Notification Engine email channel (SMTP relay)
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
# Quote if password contains # or spaces, e.g. SMTP_PASSWORD="p@ss#word"
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
EMAIL_DELIVERY_MODE=sync
SMTP_SEND_DELAY_SECONDS=2.5
# sync = deliver in API request (local); async = Celery worker
EMAIL_DELIVERY_MODE=sync
# Project stage-save admin emails. Keep false until SMTP is configured.
PROJECT_STAGE_EMAIL_NOTIFICATIONS_ENABLED=false

# Email → Service Request Ticket (IMAP mailbox poll)
EMAIL_TICKET_ENABLED=false
EMAIL_INBOUND_WEBHOOK_SECRET=
EMAIL_TICKET_DEFAULT_BRANCH_ID=
EMAIL_TICKET_DEFAULT_CATEGORY_ID=
EMAIL_TICKET_DEFAULT_CUSTOMER_ID=
EMAIL_TICKET_SUBJECT_PATTERNS=
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_SECONDS=120
SERVICE_FOLLOWUP_HOURS=24

# ElevenLabs Conversational AI (voice agent - API key server-side only)
# Either name works; XI_API_KEY is ElevenLabs' conventional name.
XI_API_KEY=
# ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_6801kz33m906e7famdw9cy2n0sgw

# MCP server (curated ERP tools for ElevenLabs)
MCP_SERVER_BASE_URL=http://127.0.0.1:8000
MCP_AUTH_TOKEN=

# Asset module - DC challan file storage (Docker: mount volume at /app/var/asset-storage)
# ASSET_STORAGE_BACKEND=local
# ASSET_STORAGE_PATH=/app/var/asset-storage
# ASSET_WORKFLOW_GOVERNANCE_ENABLED=false
# ASSET_DC_CHALLAN_MAX_UPLOAD_MB=10
# ASSET_DC_CHALLAN_SCM_API_KEY=
# ASSET_DC_CHALLAN_SCM_ALLOWED_HOSTS=

# Employee self-service login
# ESS_LOGIN_CAPTCHA_ENABLED=false

# ngrok - public MCP URL for ElevenLabs (dev). One-time: ngrok config add-authtoken <token>
# Run tunnel: .\mcp-server\scripts\tunnel-mcp.ps1  (use printed https://….ngrok-free.app/mcp/ in dashboard)
# NGROK_AUTHTOKEN=

# Asset module (local disk or S3 via OBJECT_STORAGE_BACKEND / ASSET_STORAGE_BACKEND)
# ASSET_STORAGE_BACKEND=local
# ASSET_STORAGE_PATH=./var/asset-storage
# ASSET_WORKFLOW_GOVERNANCE_ENABLED=false
ASSET_DC_CHALLAN_SCM_API_KEY=
ASSET_DC_CHALLAN_MAX_UPLOAD_MB=10
ASSET_DOCUMENT_MAX_UPLOAD_MB=10
ASSET_DC_CHALLAN_SCM_ALLOWED_HOSTS=
# Disposal CEO approval recipients (comma-separated). Empty = TENANT_ADMIN / ASSET_ADMIN users.
ASSET_DISPOSAL_APPROVER_EMAILS=

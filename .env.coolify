# Local Docker full stack (docker-compose.coolify.yml)
DEPLOY_ENV=local

POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp

RABBITMQ_USER=erp
RABBITMQ_PASSWORD=erp_dev_password

MINIO_ROOT_USER=erp_minio
MINIO_ROOT_PASSWORD=erp_minio_password
MINIO_BUCKET=erp-documents

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata

API_HOST=0.0.0.0
API_PORT=8000
RUN_MIGRATIONS=true

DATABASE_URL=postgresql+psycopg://erp:erp_dev_password@postgres:5432/erp
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://erp:erp_dev_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

CRM_UPLOAD_ROOT=/app/var/crm-attachments

JWT_SECRET_KEY=local-docker-jwt-secret-change-me-32chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_TTL_SECONDS=604800
EMAIL_DELIVERY_MODE=async

MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_FROM_EMAIL=

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=Enterprise ERP
NEXT_PUBLIC_DEMO_EMAIL=admin@example.com
NEXT_PUBLIC_DEMO_PASSWORD=Secure1!

NEXT_PUBLIC_EMPLOYEE_APP_NAME=Employee App
NEXT_PUBLIC_USE_MOCK=false

API_PUBLISH_PORT=8000
WEB_PUBLISH_PORT=3000
EMPLOYEE_PUBLISH_PORT=3001

# EAS reads .easignore from the Git repo root and uses it INSTEAD of .gitignore.
# Keep gitignore rules, then exclude monorepo bulk not needed for employee-app builds.

# --- from .gitignore ---
.env
.env.local
.env.*.local
apps/api/var/crm-attachments/*
!apps/api/var/crm-attachments/.gitkeep
apps/api/var/asset-storage/*
!apps/api/var/asset-storage/.gitkeep
apps/api/var/ess-documents/*
!apps/api/var/ess-documents/.gitkeep
apps/api/var/project-trackers/*
!apps/api/var/project-trackers/.gitkeep
apps/api/var/marketing-deliverables/*
!apps/api/var/marketing-deliverables/.gitkeep
apps/api/var/recruitment-resumes/*
!apps/api/var/recruitment-resumes/.gitkeep
apps/api/var/recruitment-bg-docs/*
!apps/api/var/recruitment-bg-docs/.gitkeep
apps/api/var/recruitment-job-evidence/*
!apps/api/var/recruitment-job-evidence/.gitkeep
apps/api/src/var/
apps/api/var/*.jsonl
var/vm-sync/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/

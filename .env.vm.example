# =============================================================================
# VM single-stack env — copy to .env.vm and edit before deploy-vm.sh
# =============================================================================

# Public host users open in the browser (no trailing slash)
VM_HOST=172.16.200.30
HTTP_PORT=80

ENVIRONMENT=production
DEBUG=false

# Postgres (app DB = erp_hrms; fuller archive also restored as erp)
POSTGRES_USER=erp-postgres
POSTGRES_PASSWORD=erp-postgres
POSTGRES_DB=erp_hrms
POSTGRES_HOST_PORT=5433

# RabbitMQ
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=erp_dev_password

# MinIO / S3-compatible
MINIO_ROOT_USER=erp_minio
MINIO_ROOT_PASSWORD=erp_minio_password
S3_BUCKET=cache-erp-bucket
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=erp_minio
AWS_SECRET_ACCESS_KEY=erp_minio_password
OBJECT_STORAGE_BACKEND=s3
ASSET_STORAGE_BACKEND=s3

# Auth — change in real VM
JWT_SECRET_KEY=change-me-to-a-long-random-string

# URLs (same-origin via nginx :80 → /api/v1)
FRONTEND_URL=http://172.16.200.30
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=iConnect Plus
CORS_ORIGINS=["http://172.16.200.30","http://localhost","http://127.0.0.1"]

# SMTP (optional — leave blank to skip outbound mail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# First boot: run Alembic after restore
RUN_MIGRATIONS=true

# =============================================================================
# Coolify / Docker Compose production stack
# Copy to repo root: cp .env.coolify.example .env.coolify
# Used by: docker compose -f docker-compose.coolify.yml --env-file .env.coolify up -d
# =============================================================================

# staging | production — label for ops (Coolify environment name)
DEPLOY_ENV=staging

# -----------------------------------------------------------------------------
# PostgreSQL (service name: postgres)
# -----------------------------------------------------------------------------
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=erp

# -----------------------------------------------------------------------------
# RabbitMQ (service name: rabbitmq)
# -----------------------------------------------------------------------------
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=change-me-strong-password

# -----------------------------------------------------------------------------
# MinIO (optional profile: full)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=erp_minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=erp-documents

# -----------------------------------------------------------------------------
# API / Celery (shared by api, celery-worker, celery-beat)
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata

API_HOST=0.0.0.0
API_PORT=8000
RUN_MIGRATIONS=true

DATABASE_URL=postgresql+psycopg://erp:change-me-strong-password@postgres:5432/erp
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://erp:change-me-strong-password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Browser origins (admin + employee). JSON array for Docker/Pydantic.
CORS_ORIGINS=["http://172.16.200.26:3000","http://172.16.200.26:3001"]
# Optional LAN/private IP pattern (uncomment if needed):
# CORS_ORIGIN_REGEX=https?://(172\.16\.\d{1,3}\.\d{1,3}|localhost|127\.0\.0\.1)(:\d+)?

CRM_UPLOAD_ROOT=/app/var/crm-attachments

JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_TTL_SECONDS=86400
EMAIL_DELIVERY_MODE=async

# MinIO — set when using profile "full"; API uses for future S3-backed uploads
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# Azure Graph (optional)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Frontends (build-time args for Docker — rebuild after changing API URL)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://172.16.200.26:8080/api/v1
NEXT_PUBLIC_APP_NAME=Enterprise ERP
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

NEXT_PUBLIC_EMPLOYEE_APP_NAME=Employee App
NEXT_PUBLIC_USE_MOCK=false

# Host ports published on the Coolify server (avoid 8000 — Coolify UI)
API_PUBLISH_PORT=8080
WEB_PUBLISH_PORT=3000
EMPLOYEE_PUBLISH_PORT=3001

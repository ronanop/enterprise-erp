!apps/api/var/asset-storage/.gitkeep
apps/api/var/ess-documents/*
!apps/api/var/ess-documents/.gitkeep
apps/api/var/project-trackers/*
!apps/api/var/project-trackers/.gitkeep
apps/api/var/marketing-deliverables/*
!apps/api/var/marketing-deliverables/.gitkeep
apps/api/var/*.jsonl

